{% extends 'base.html.twig' %}

{% block title %}Trouver une banque de sang{% endblock %}
{% block classe_main %}conteneur-large{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('vendor/leaflet/leaflet.css') }}">
{% endblock %}

{% block corps %}
    <div class="recherche">
        <div>
            <h1>Trouver une banque de sang près de vous</h1>
            <p class="chapeau">Les stocks affichés sont ceux déclarés par les banques.
                L’heure de la dernière mise à jour est indiquée sur chaque résultat.</p>
        </div>

        <form class="recherche-formulaire" method="get" action="{{ path('carte') }}">
            <div class="champ">
                <label for="groupe">Groupe sanguin recherché</label>
                <select id="groupe" name="groupe">
                    <option value="">Tous les groupes</option>
                    {% for groupe in groupes %}
                        <option value="{{ groupe.code }}"
                                {{ groupeChoisi and groupeChoisi.id == groupe.id ? 'selected' : '' }}>
                            {{ groupe.code }}
                        </option>
                    {% endfor %}
                </select>
            </div>

            <div class="champ">
                <label for="rayon">Distance maximale</label>
                <select id="rayon" name="rayon">
                    {% for valeur in [5, 10, 25, 50, 100] %}
                        <option value="{{ valeur }}" {{ rayon == valeur ? 'selected' : '' }}>
                            {{ valeur }} km
                        </option>
                    {% endfor %}
                </select>
            </div>

            <input type="hidden" name="lat" id="lat" value="{{ app.request.query.get('lat') }}">
            <input type="hidden" name="lon" id="lon" value="{{ app.request.query.get('lon') }}">

            <button type="submit" class="bouton bouton-principal">Rechercher</button>
            <button type="button" class="bouton bouton-secondaire" id="ma-position">
                Utiliser ma position
            </button>
        </form>
    </div>

    <div class="carte-page">
        <div id="carte" class="carte"
             data-centre-lat="{{ centre.latitude }}"
             data-centre-lon="{{ centre.longitude }}"
             data-groupe="{{ groupeChoisi ? groupeChoisi.code : '' }}"
             data-images="{{ asset('images/') }}"
             data-api="{{ path('api_banques') }}"
             role="application"
             aria-label="Carte des banques de sang">
        </div>

        <section class="resultats" aria-live="polite">
            <h2>{{ resultats|length }} banque{{ resultats|length > 1 ? 's' : '' }}
                {% if groupeChoisi %}avec du {{ groupeChoisi.code }}{% endif %}</h2>

            {% if resultats is empty %}
                <p class="vide">Aucune banque ne correspond à cette recherche.
                    Élargissez la distance ou essayez un groupe compatible.</p>
            {% endif %}

            <ul class="liste-banques">
                {% for ligne in resultats %}
                    {% set banque = ligne.banque %}
                    <li class="carte-banque">
                        <a class="carte-banque-titre" href="{{ path('banque_fiche', {id: banque.id}) }}">
                            {{ banque.nom }}
                        </a>
                        <p class="carte-banque-adresse">
                            {{ ligne.distance|distance }} · {{ banque.ville }} — {{ banque.adresse }}
                        </p>
                        <p class="carte-banque-etat">
                            <span class="pastille {{ ligne.etat|classe_etat }}">
                                {{ ligne.etat|libelle_etat }}
                            </span>
                            {% if groupeChoisi %}
                                <span class="groupe">{{ groupeChoisi.code }}</span>
                                <strong>{{ ligne.quantite }} poche{{ ligne.quantite > 1 ? 's' : '' }}</strong>
                            {% else %}
                                <span class="muet">Voir le détail des groupes</span>
                            {% endif %}
                        </p>
                    </li>
                {% endfor %}
            </ul>
        </section>
    </div>
{% endblock %}

{% block javascripts %}
    <script src="{{ asset('vendor/leaflet/leaflet.js') }}"></script>
    <script src="{{ asset('js/carte.js') }}"></script>
{% endblock %}
