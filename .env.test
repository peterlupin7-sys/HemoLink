# ---------------------------------------------------------------------------
# Environnement de test : base séparée, SMS désactivés, journaux muets.
# ---------------------------------------------------------------------------
APP_ENV=test
APP_SECRET=secret_de_test_hemolink_2026
APP_DEBUG=0

DATABASE_URL="mysql://root:@127.0.0.1:3306/hemolink_test?serverVersion=10.4.32-MariaDB&charset=utf8mb4"

MESSENGER_TRANSPORT_DSN=in-memory://

SMS_MODE=simulation
SMS_URL=
SMS_CLE_API=
SMS_EXPEDITEUR=HEMOLINK

CARTE_LATITUDE=6.3703
CARTE_LONGITUDE=2.3912
CARTE_ZOOM=12

DOSSIER_SAUVEGARDE=var/sauvegardes

KERNEL_CLASS='App\Kernel'
SYMFONY_DEPRECATIONS_HELPER=999999
PANTHER_APP_ENV=panther
PANTHER_ERROR_SCREENSHOT_DIR=./var/error-screenshots
