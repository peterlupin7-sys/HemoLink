# ---------------------------------------------------------------------------
# HemoLink — variables d'environnement
#
# Ce fichier est versionné : il ne contient QUE des valeurs de développement.
# Pour vos réglages locaux, créez un fichier .env.local (ignoré par Git).
# ---------------------------------------------------------------------------

###> symfony/framework-bundle ###
APP_ENV=dev
APP_SECRET=changez_cette_valeur_en_production_32_caracteres
###< symfony/framework-bundle ###

###> doctrine/doctrine-bundle ###
# XAMPP : utilisateur root sans mot de passe par défaut.
# MariaDB : serverVersion=10.4.32-MariaDB — MySQL 8 : serverVersion=8.0.36
DATABASE_URL="mysql://root:@127.0.0.1:3306/hemolink?serverVersion=10.4.32-MariaDB&charset=utf8mb4"
###< doctrine/doctrine-bundle ###

###> symfony/messenger ###
# Les SMS partent dans une file en base : si le réseau tombe, rien n'est perdu.
MESSENGER_TRANSPORT_DSN=doctrine://default?auto_setup=0
###< symfony/messenger ###

###> hemolink ###
# Passerelle SMS. Laissez SMS_MODE=simulation tant que vous n'avez pas de contrat
# opérateur : les messages sont alors écrits en base et dans les logs, sans envoi.
SMS_MODE=simulation
SMS_URL=
SMS_CLE_API=
SMS_EXPEDITEUR=HEMOLINK

# Centre de la carte au premier affichage (Cotonou).
CARTE_LATITUDE=6.3703
CARTE_LONGITUDE=2.3912
CARTE_ZOOM=12

# Dossier des sauvegardes produites par « php bin/console app:sauvegarde ».
DOSSIER_SAUVEGARDE=var/sauvegardes
###< hemolink ###
